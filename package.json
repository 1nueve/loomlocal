{
  "name": "loomlocal",
  "productName": "LoomLocal",
  "version": "0.1.0",
  "private": true,
  "description": "Grabadora de pantalla y cámara local, de uso personal: burbuja de cámara, dibujo, marcadores, biblioteca, enlaces en tu red y transcripción local.",
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "npm run build && playwright test --trace off",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.3.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.19.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "5.9.3",
    "vite": "8.1.7",
    "vitest": "5.1.0"
  }
}
